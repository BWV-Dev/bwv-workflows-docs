{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "docusaurus.config.ts",
    "sidebars.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
