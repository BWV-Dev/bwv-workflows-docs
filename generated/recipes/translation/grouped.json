{
  "path": "recipes/translation/grouped.yml",
  "inputs": [
    {
      "name": "sourceRoot",
      "type": "path",
      "required": true
    },
    {
      "name": "outputRoot",
      "type": "path",
      "required": true
    },
    {
      "name": "glossary",
      "type": "path",
      "required": true
    },
    {
      "name": "syncBase",
      "type": "string",
      "required": true
    },
    {
      "name": "sourceBranch",
      "type": "string",
      "required": true
    },
    {
      "name": "gateBases",
      "type": "array",
      "required": true
    },
    {
      "name": "branchPrefix",
      "type": "string",
      "required": true
    },
    {
      "name": "model",
      "type": "string",
      "required": false,
      "default": "sonnet"
    },
    {
      "name": "maxFilesPerGroup",
      "type": "number",
      "required": false,
      "default": 3
    },
    {
      "name": "toolkit",
      "type": "toolkit",
      "required": false,
      "default": {
        "translate": {
          "skill": "translate-doc"
        },
        "syncCache": {
          "skill": "sync-translation-cache"
        },
        "checkOutputs": {
          "script": "scripts/check-group-outputs.sh"
        },
        "checkDrift": {
          "script": "scripts/check-cache-drift.sh"
        }
      }
    }
  ]
}
