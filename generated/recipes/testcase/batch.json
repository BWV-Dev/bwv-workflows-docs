{
  "path": "recipes/testcase/batch.yml",
  "description": "Generate testcases from reviewed translations in batches, one pull request per batch, whenever a translation lands on one of the given branches. Progress is recomputed from the tree on every pass, so a run that stops half-way resumes where it left off.",
  "inputs": [
    {
      "name": "sourceRoot",
      "type": "path",
      "required": true
    },
    {
      "name": "outputRoot",
      "type": "path",
      "required": true
    },
    {
      "name": "branches",
      "type": "array",
      "required": true
    },
    {
      "name": "branchPrefix",
      "type": "string",
      "required": true
    },
    {
      "name": "model",
      "type": "string",
      "required": false,
      "default": "sonnet"
    },
    {
      "name": "maxIterations",
      "type": "number",
      "required": false,
      "default": 10
    },
    {
      "name": "toolkit",
      "type": "toolkit",
      "required": false,
      "default": {
        "plan": {
          "script": "scripts/plan-testcase-batch.sh"
        },
        "generate": {
          "skill": "generate-testcases"
        }
      }
    }
  ]
}
