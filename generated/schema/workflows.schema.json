{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "defaults": {
      "default": {},
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "default": "sonnet"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "maxTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "default": 30
        },
        "timeoutMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "default": 20
        },
        "permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "dontAsk",
            "plan",
            "bypassPermissions"
          ],
          "default": "acceptEdits"
        },
        "maxBudgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "workflows": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "on": {
                "type": "object",
                "properties": {
                  "pull_request": {
                    "type": "object",
                    "properties": {
                      "types": {
                        "default": [
                          "opened",
                          "synchronize"
                        ],
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "opened",
                            "reopened",
                            "synchronize",
                            "ready_for_review",
                            "closed"
                          ]
                        }
                      },
                      "base": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "merged": {
                        "type": "boolean"
                      },
                      "head": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "paths": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^(?!!)"
                        }
                      },
                      "ignorePaths": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^(?!!)"
                        }
                      }
                    },
                    "required": [
                      "base"
                    ],
                    "additionalProperties": false
                  },
                  "push": {
                    "type": "object",
                    "properties": {
                      "branches": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "paths": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^(?!!)"
                        }
                      },
                      "ignorePaths": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^(?!!)"
                        }
                      }
                    },
                    "required": [
                      "branches"
                    ],
                    "additionalProperties": false
                  },
                  "manual": {
                    "type": "object",
                    "properties": {
                      "branches": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "branches"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "steps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "if": {
                          "type": "string"
                        },
                        "forEach": {
                          "type": "string"
                        },
                        "fanout": {
                          "type": "string",
                          "enum": [
                            "subagent",
                            "process"
                          ]
                        },
                        "maxParallel": {
                          "default": 3,
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 20
                        },
                        "continueOnError": {
                          "default": false,
                          "type": "boolean"
                        },
                        "timeoutMinutes": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "claude": {
                          "type": "object",
                          "properties": {
                            "prompt": {
                              "type": "string"
                            },
                            "promptFile": {
                              "type": "string"
                            },
                            "skill": {
                              "type": "string"
                            },
                            "command": {
                              "type": "string"
                            },
                            "args": {
                              "type": "string"
                            },
                            "model": {
                              "type": "string"
                            },
                            "effort": {
                              "type": "string",
                              "enum": [
                                "low",
                                "medium",
                                "high",
                                "xhigh",
                                "max"
                              ]
                            },
                            "allowedTools": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "disallowedTools": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "permissionMode": {
                              "type": "string",
                              "enum": [
                                "default",
                                "acceptEdits",
                                "dontAsk",
                                "plan",
                                "bypassPermissions"
                              ]
                            },
                            "maxTurns": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            },
                            "maxBudgetUsd": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "appendSystemPrompt": {
                              "type": "string"
                            },
                            "outputSchema": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {}
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "claude"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "if": {
                          "type": "string"
                        },
                        "forEach": {
                          "type": "string"
                        },
                        "fanout": {
                          "type": "string",
                          "enum": [
                            "subagent",
                            "process"
                          ]
                        },
                        "maxParallel": {
                          "default": 3,
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 20
                        },
                        "continueOnError": {
                          "default": false,
                          "type": "boolean"
                        },
                        "timeoutMinutes": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "shell": {
                          "type": "string",
                          "minLength": 1
                        },
                        "outputJson": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "shell"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "if": {
                          "type": "string"
                        },
                        "forEach": {
                          "type": "string"
                        },
                        "fanout": {
                          "type": "string",
                          "enum": [
                            "subagent",
                            "process"
                          ]
                        },
                        "maxParallel": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 20
                        },
                        "continueOnError": {
                          "type": "boolean"
                        },
                        "timeoutMinutes": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "uses": {
                          "type": "string",
                          "minLength": 1,
                          "not": {
                            "pattern": "^[^@]*@(?:[rR][eE][fF][sS]|[pP][uU][lL][lL]|[gG][hH]-[rR][eE][aA][dD][oO][nN][lL][yY]-[qQ][uU][eE][uU][eE])/"
                          }
                        },
                        "with": {
                          "default": {},
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "uses"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "fetchDepth": {
                "default": 1,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "context": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "submodule": {
                      "type": "string"
                    },
                    "repo": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$"
                    },
                    "require": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "submodule",
                    "repo"
                  ],
                  "additionalProperties": false
                }
              },
              "statusComment": {
                "default": true,
                "type": "boolean"
              },
              "loop": {
                "type": "object",
                "properties": {
                  "while": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxIterations": {
                    "default": 20,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "summary": {
                    "type": "string"
                  },
                  "closed": {
                    "default": "skip",
                    "type": "string",
                    "enum": [
                      "skip",
                      "redo"
                    ]
                  }
                },
                "required": [
                  "while"
                ],
                "additionalProperties": false
              },
              "onSuccess": {
                "type": "object",
                "properties": {
                  "if": {
                    "type": "string"
                  },
                  "commitMessage": {
                    "default": "chore(bwv): automated update",
                    "type": "string"
                  },
                  "createPullRequest": {
                    "type": "object",
                    "properties": {
                      "branch": {
                        "type": "string",
                        "minLength": 1
                      },
                      "base": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "body": {
                        "type": "string"
                      },
                      "draft": {
                        "default": false,
                        "type": "boolean"
                      },
                      "labels": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "branch",
                      "title"
                    ],
                    "additionalProperties": false
                  },
                  "comment": {
                    "default": false,
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "sourcePrGrouping": {
                "type": "object",
                "properties": {
                  "paths": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!!)"
                    }
                  },
                  "ignorePaths": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!!)"
                    }
                  },
                  "sourceRoot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requireOutputs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "maxFilesPerGroup": {
                    "default": 3,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "paths",
                  "requireOutputs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "on",
              "steps"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "uses": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "^[^@]*@(?:[rR][eE][fF][sS]|[pP][uU][lL][lL]|[gG][hH]-[rR][eE][aA][dD][oO][nN][lL][yY]-[qQ][uU][eE][uU][eE])/"
                }
              },
              "with": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "name",
              "uses"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "workflows"
  ],
  "additionalProperties": false
}
